{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022","DOM","DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "noUnusedLocals": false, "resolveJsonModule": true, "isolatedModules": true,
    "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "baseUrl": ".", "paths": { "@contracts/*": ["../../packages/contracts/*"], "@/*": ["src/*"] },
    "types": ["vite/client"]
  },
  "include": ["src", "../../packages/contracts/src"]
}
