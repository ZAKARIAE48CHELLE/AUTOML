{
  "type": "data.split",
  "version": "1.0",
  "label": "Split",
  "owner": "E1",
  "operation_class": "L1",
  "adapter": "POST /splits",
  "input_ports": [
    {
      "name": "dataset",
      "type": "Dataset",
      "multiple": false
    }
  ],
  "output_ports": [
    {
      "name": "split",
      "type": "Split",
      "multiple": false
    }
  ],
  "params_schema": {
    "type": "object",
    "required": [
      "strategy",
      "test_ratio",
      "cv_folds",
      "seed"
    ],
    "properties": {
      "strategy": {
        "type": "string",
        "title": "Stratégie",
        "enum": [
          "random",
          "stratified",
          "group",
          "time"
        ],
        "default": "stratified"
      },
      "test_ratio": {
        "type": "number",
        "title": "Part du jeu de test",
        "minimum": 0.05,
        "maximum": 0.5,
        "default": 0.2
      },
      "cv_folds": {
        "type": "integer",
        "title": "Plis de validation croisée",
        "minimum": 1,
        "maximum": 10,
        "default": 5
      },
      "val_ratio": {
        "type": "number",
        "title": "Part de validation (si 1 pli)",
        "minimum": 0.05,
        "maximum": 0.4,
        "default": 0.2
      },
      "seed": {
        "type": "integer",
        "title": "Graine",
        "minimum": 0,
        "default": 42
      },
      "target": {
        "type": "string",
        "title": "Colonne cible",
        "x-source": "columns",
        "x-role": "target"
      },
      "group_column": {
        "type": "string",
        "title": "Colonne de groupe",
        "x-source": "columns",
        "x-role": "group_column"
      },
      "time_column": {
        "type": "string",
        "title": "Colonne temporelle",
        "x-source": "columns",
        "x-role": "time_column"
      },
      "text_column": {
        "type": "string",
        "title": "Colonne de texte",
        "x-source": "columns",
        "x-role": "text_column"
      },
      "image_column": {
        "type": "string",
        "title": "Colonne chemin d'image",
        "x-source": "columns",
        "x-role": "image_column"
      },
      "user_column": {
        "type": "string",
        "title": "Colonne utilisateur",
        "x-source": "columns",
        "x-role": "user_column"
      },
      "item_column": {
        "type": "string",
        "title": "Colonne article",
        "x-source": "columns",
        "x-role": "item_column"
      }
    }
  },
  "params_doc": "SplitSpec (stratégie, test_ratio, cv_folds, val_ratio, seed, cible, colonnes groupe/temps)"
}