# AI Studio — Environment Configuration Template
GATEWAY_PORT=8080
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081

# Microservices Ports (Internal)
E1_SERVICE_URL=http://e1-data-service:8001
E2_SERVICE_URL=http://e2-training-service:8002
E3_SERVICE_URL=http://e3-assistant-service:8003
E4_SERVICE_URL=http://e4-studio-service:8004

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aistudio
POSTGRES_PASSWORD=change_me_local_password
E1_DATABASE_URL=postgresql://aistudio:change_me_local_password@postgres:5432/e1_data
E2_DATABASE_URL=postgresql://aistudio:change_me_local_password@postgres:5432/e2_training
E3_DATABASE_URL=postgresql://aistudio:change_me_local_password@postgres:5432/e3_assistant
E4_DATABASE_URL=postgresql://aistudio:change_me_local_password@postgres:5432/e4_studio

# Cache & Message Broker
REDIS_URL=redis://redis:6379/0

# Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me_minio_user
MINIO_SECRET_KEY=change_me_minio_secret

# MLflow Tracking
MLFLOW_TRACKING_URI=http://mlflow:5000

# LLM Configuration for E3 Assistant
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3:8b
LLM_API_KEY=

# Security
JWT_SECRET=replace_with_a_long_random_secret_in_production
